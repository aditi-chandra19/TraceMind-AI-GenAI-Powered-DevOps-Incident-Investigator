NODE_ENV=development
DEMO_MODE=false
PORT=4000
WEB_ORIGIN=http://localhost:5173

# Local MongoDB container. Keep these values in your untracked .env file.
MONGO_ROOT_USERNAME=tracemind
MONGO_ROOT_PASSWORD=replace-with-a-long-random-password
MONGODB_URI=mongodb://tracemind:replace-with-a-long-random-password@127.0.0.1:27018/tracemind?authSource=admin

# Generate a unique value with at least 32 characters before running locally.
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters

# Used by `npm run db:seed` to create the first admin in MongoDB.
ADMIN_EMAIL=admin@tracemind.local
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters

# Only used when DEMO_MODE=true.
DEMO_ADMIN_EMAIL=admin@tracemind.local
DEMO_ADMIN_PASSWORD=TraceMindDemo!2026

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MAX_UPLOAD_MB=25
